---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.tsx';
import PersonaTransition from '../../components/PersonaTransition.tsx';
import SectionReveal from '../../components/SectionReveal.tsx';
import { aiConfig } from '../../config/ai.config';
import { siteConfig } from '../../config/site.config';

const ai = aiConfig;
const featuredProjects = ai.projects.filter((project) => project.featured);
const otherProjects = ai.projects.filter((project) => !project.featured);
const linkedIn = siteConfig.contact.socials.find((social) => social.label === 'LinkedIn');
---

<BaseLayout title={ai.title} persona="tech">
  <Nav client:load />
  <PersonaTransition client:load />
  <header class="relative border-b border-white/10 px-6 pt-36 pb-20 md:pt-44 md:pb-28">
    <div class="mx-auto max-w-6xl">
      <p class="mb-5 text-xs font-semibold uppercase tracking-[0.25em] text-cyan-200">{ai.eyebrow}</p>
      <h1 class="mb-6 text-5xl font-semibold tracking-[-0.06em] md:text-7xl">{ai.heading}</h1>
      <p class="max-w-2xl text-lg leading-relaxed text-white/65 md:text-xl">{ai.introduction}</p>
      <div class="mt-10 flex max-w-4xl flex-wrap gap-2">
        {ai.skills.map((skill) => <span class="rounded-full border border-white/15 px-3 py-1 text-xs text-white/65">{skill}</span>)}
      </div>
    </div>
  </header>
  <main class="mx-auto max-w-6xl space-y-24 px-6 py-20 md:py-28">
    <section id="experience" aria-labelledby="experience-heading" class="scroll-mt-28 grid gap-10 lg:grid-cols-[minmax(0,15rem)_minmax(0,1fr)] lg:gap-14">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-cyan-200">{ai.eyebrow}</p>
        <h2 id="experience-heading" class="text-3xl font-semibold tracking-tight md:text-4xl">{ai.labels.experience}</h2>
        <p class="mt-4 text-sm leading-relaxed text-white/55">{ai.labels.experienceIntro}</p>
        {linkedIn && <a href={linkedIn.url} target="_blank" rel="noopener noreferrer" class="mt-6 inline-block border-b border-cyan-200/45 pb-1 text-sm text-cyan-200 hover:text-white">{linkedIn.label} ↗</a>}
      </div>
      <ol class="relative space-y-5 border-l border-white/15 pl-5 sm:pl-8">
        {ai.experiences.map((entry, index) => (
          <li class="relative">
            <span class="absolute -left-[26px] top-7 h-2.5 w-2.5 rounded-full border-2 border-[#82bcc9] bg-[#0d1318] sm:-left-[38px]" aria-hidden="true"></span>
            <article class="rounded-xl border border-white/10 bg-white/[0.025] p-5 sm:p-7">
              <div class="mb-3 flex flex-wrap items-start justify-between gap-2">
                <span class="text-xs font-medium uppercase tracking-[0.15em] text-cyan-200/75">{String(index + 1).padStart(2, '0')} / {String(ai.experiences.length).padStart(2, '0')}</span>
                <span class="text-xs tabular-nums text-white/50">{entry.duration}</span>
              </div>
              <h3 class="text-lg font-semibold tracking-tight text-white sm:text-xl">{entry.company}</h3>
              <p class="mt-1 text-sm text-cyan-200">{entry.role}</p>
              <ul class="mt-5 space-y-2 text-sm leading-relaxed text-white/65">
                {entry.highlights.map((highlight) => <li class="flex gap-3"><span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-cyan-200/70" aria-hidden="true"></span><span>{highlight}</span></li>)}
              </ul>
              {entry.techStack.length > 0 && <div class="mt-5 flex flex-wrap gap-2 border-t border-white/10 pt-5">{entry.techStack.map((tech) => <span class="rounded-full border border-white/10 px-2.5 py-1 text-xs text-white/60">{tech}</span>)}</div>}
            </article>
          </li>
        ))}
      </ol>
    </section>
    <section id="projects" aria-labelledby="projects-heading" class="scroll-mt-28">
      <SectionReveal client:visible><h2 id="projects-heading" class="mb-8 text-3xl font-semibold tracking-tight md:text-4xl">{ai.labels.featured}</h2></SectionReveal>
      <div class="grid gap-4 md:grid-cols-2">
        {featuredProjects.map((project) => (
          <article class="rounded-xl border border-white/10 bg-white/[0.025] p-6 md:p-8">
            <h3 class="text-xl font-semibold tracking-tight">{project.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-white/60">{project.description}</p>
            <div class="mt-6 grid gap-4 text-sm text-white/60"><div><span class="mb-1 block text-xs uppercase tracking-wider text-cyan-200">{ai.labels.problem}</span>{project.problem}</div><div><span class="mb-1 block text-xs uppercase tracking-wider text-cyan-200">{ai.labels.solution}</span>{project.solution}</div></div>
            <div class="mt-6 flex flex-wrap gap-2">{project.techStack.map((tech) => <span class="rounded-full bg-white/[0.06] px-2.5 py-1 text-xs text-white/60">{tech}</span>)}</div>
          </article>
        ))}
      </div>
      {otherProjects.length > 0 && <div class="mt-12"><h3 class="mb-5 text-xl font-semibold">{ai.labels.other}</h3><div class="grid gap-4 md:grid-cols-2">{otherProjects.map((project) => <article class="rounded-xl border border-white/10 p-6"><h4 class="text-lg font-semibold">{project.title}</h4><p class="mt-2 text-sm text-white/60">{project.description}</p><div class="mt-4 flex flex-wrap gap-2">{project.techStack.map((tech) => <span class="rounded-full bg-white/[0.06] px-2.5 py-1 text-xs text-white/60">{tech}</span>)}</div></article>)}</div></div>}
    </section>
    <section aria-labelledby="connect-heading" class="border-t border-white/10 pt-10"><h2 id="connect-heading" class="mb-5 text-2xl font-semibold">{ai.labels.connect}</h2><div class="flex gap-5">{siteConfig.contact.socials.filter((social) => social.label !== 'Instagram').map((social) => <a href={social.url} target="_blank" rel="noopener noreferrer" class="border-b border-cyan-200/50 pb-1 text-sm text-cyan-200 hover:text-white">{social.label} ↗</a>)}</div></section>
  </main>
</BaseLayout>
