---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.tsx';
import SectionReveal from '../../components/SectionReveal.tsx';
import { siteConfig } from '../../config/site.config';
import { musicConfig } from '../../config/music.config';

const music = musicConfig;
const dateFormat = new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title={`${music.tourAction} — ${siteConfig.name}`} persona="music">
  <Nav client:load />
  <section class="mx-auto max-w-4xl px-6 pt-28 pb-20">
    <SectionReveal client:visible>
      <a href={`${siteConfig.base}/music/`} class="mb-6 inline-block text-sm font-medium text-rose-200 hover:text-white">← {music.labels.back}</a>
      <h1 class="mb-4 text-4xl font-semibold tracking-tight md:text-5xl">{music.tourAction}</h1>
      <p class="mb-12 text-lg text-[var(--text-secondary)]">{music.availability}</p>
    </SectionReveal>

    <section aria-labelledby="raum27-tour">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
        <div><p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-rose-200">{music.tourSubtitle}</p><h2 id="raum27-tour" class="text-2xl font-semibold md:text-3xl">{music.tourTitle}</h2></div>
        <a href={music.ticketUrl} target="_blank" rel="noopener noreferrer" class="border-b border-rose-300/60 pb-1 text-sm font-medium text-rose-200 hover:text-white">{music.ticketsLabel} ↗</a>
      </div>
      <ol class="divide-y divide-white/10 border-y border-white/10">
        {music.tour.map((show) => (
          <li class="grid grid-cols-[6rem_1fr] items-baseline gap-3 py-4 sm:grid-cols-[8rem_1fr_1fr] sm:gap-5">
            <time datetime={show.date} class="text-sm tabular-nums text-rose-200">{dateFormat.format(new Date(`${show.date}T00:00:00Z`))}</time>
            <span class="font-semibold text-white">{show.city}</span>
            <span class="col-start-2 text-sm text-[var(--text-secondary)] sm:col-start-auto">{show.venue}</span>
          </li>
        ))}
      </ol>
      <p class="mt-4 text-xs text-[var(--text-secondary)]"><a href={music.tourSource} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-white">{music.labels.source}</a></p>
    </section>

  </section>
</BaseLayout>
