---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.tsx';
import PersonaTransition from '../../components/PersonaTransition.tsx';
import SectionReveal from '../../components/SectionReveal.tsx';
import VideoShowcase from '../../components/VideoShowcase.tsx';
import { siteConfig } from '../../config/site.config';
import { musicConfig } from '../../config/music.config';

const { base, name } = siteConfig;
const music = musicConfig;
const formatDate = (date: string) => new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${date}T00:00:00Z`));
---

<BaseLayout title={music.title} persona="music">
  <Nav client:load />
  <PersonaTransition client:load />

  <header class="relative flex min-h-[570px] items-end overflow-hidden pt-32 pb-20 md:min-h-[620px]">
    <img src={music.heroImage} alt="" class="absolute inset-0 h-full w-full object-cover object-center grayscale" />
    <div class="absolute inset-0 bg-gradient-to-t from-[var(--bg-primary)] via-[#101010]/65 to-black/40"></div>
    <div class="relative mx-auto w-full max-w-6xl px-6">
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.26em] text-rose-200">{music.eyebrow}</p>
      <h1 class="mb-5 text-5xl font-semibold tracking-[-0.06em] md:text-7xl">{name}</h1>
      <p class="max-w-2xl text-lg leading-relaxed text-white/80 md:text-xl">{music.introduction}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`${base}/music/tour-dates/`} class="rounded-full border border-rose-300/50 bg-rose-300/10 px-5 py-2.5 text-sm font-medium text-rose-100 hover:bg-rose-300/20">{music.tourAction} ↗</a>
        <a href="#epk" class="rounded-full border border-white/25 px-5 py-2.5 text-sm font-medium text-white/85 hover:bg-white/10">{music.epk.title} ↓</a>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-6xl space-y-24 px-6 py-16 md:py-24">
    <section aria-labelledby="tour-heading">
      <SectionReveal client:visible>
        <div class="mb-8 flex flex-wrap items-end justify-between gap-5">
          <div>
            <p class="mb-2 text-xs uppercase tracking-[0.22em] text-rose-200">{music.tourSubtitle}</p>
            <h2 id="tour-heading" class="text-3xl font-semibold tracking-tight md:text-4xl">{music.tourTitle}</h2>
            <p class="mt-3 max-w-xl text-sm text-white/55">{music.tourIntro}</p>
          </div>
          <a href={`${base}/music/tour-dates/`} class="border-b border-rose-300/60 pb-1 text-sm text-rose-200 hover:text-white">{music.tourAction} ↗</a>
        </div>
      </SectionReveal>
      <ol class="divide-y divide-white/10 border-y border-white/10">
        {music.tour.slice(0, 5).map((show) => (
          <li class="grid grid-cols-[6rem_1fr] items-baseline gap-3 py-4 sm:grid-cols-[8rem_1fr_1fr]">
            <time datetime={show.date} class="text-sm tabular-nums text-rose-200">{formatDate(show.date)}</time>
            <span class="font-medium text-white">{show.city}</span>
            <span class="col-start-2 text-sm text-white/55 sm:col-start-auto">{show.venue}</span>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="acts-heading">
      <SectionReveal client:visible>
        <h2 id="acts-heading" class="mb-7 text-3xl font-semibold tracking-tight">{music.labels.acts}</h2>
      </SectionReveal>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {music.acts.map((act) => (
          <div class="rounded-xl border border-white/10 bg-white/[0.025] px-5 py-4">
            <h3 class="font-medium text-white">{act.name}</h3>
            <p class="mt-1 text-xs uppercase tracking-wider text-rose-200/75">{act.role}</p>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="video-heading">
      <SectionReveal client:visible><h2 id="video-heading" class="mb-8 text-3xl font-semibold tracking-tight">{music.labels.videos}</h2></SectionReveal>
      <VideoShowcase client:visible videos={[...music.videos]} />
    </section>

    <section aria-labelledby="credit-heading">
      <SectionReveal client:visible><h2 id="credit-heading" class="mb-7 text-3xl font-semibold tracking-tight">{music.labels.credits}</h2></SectionReveal>
      <div class="grid gap-4 sm:grid-cols-2">
        {music.credits.map((credit) => (
          <div class="rounded-xl border border-white/10 bg-white/[0.025] p-6">
            <p class="mb-2 text-xs uppercase tracking-wider text-rose-200">{credit.kind} · {credit.artist}</p>
            <h3 class="text-xl font-semibold">{credit.title}</h3>
            <p class="mt-2 text-sm text-white/60">{credit.detail}</p>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="gallery-heading">
      <SectionReveal client:visible><h2 id="gallery-heading" class="mb-8 text-3xl font-semibold tracking-tight">{music.labels.gallery}</h2></SectionReveal>
      <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
        {music.gallery.map((photo) => (
          <div class="aspect-square overflow-hidden rounded-lg bg-white/5"><img src={photo.src} alt={photo.alt} class="h-full w-full object-cover grayscale transition-[filter,transform] duration-500 hover:scale-[1.03] hover:grayscale-0" loading="lazy" /></div>
        ))}
      </div>
    </section>

    <section id="epk" aria-labelledby="epk-heading" class="scroll-mt-24 border-t border-white/15 pt-16">
      <div class="grid gap-10 md:grid-cols-[1fr_0.8fr] md:gap-16">
        <div>
          <p class="mb-3 text-xs uppercase tracking-[0.2em] text-rose-200">{music.epk.eyebrow}</p>
          <h2 id="epk-heading" class="text-3xl font-semibold tracking-tight md:text-4xl">{music.epk.title}</h2>
          <p class="mt-5 max-w-xl leading-relaxed text-white/65">{music.epk.description}</p>
          <p class="mt-5 text-sm text-white/50">{music.availability}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={music.epk.downloadUrl} download class="rounded-full bg-[#df8c83] px-5 py-2.5 text-sm font-semibold text-[#151515] hover:bg-[#f2a79e]">{music.epk.action} ↓</a>
            <a href={`mailto:${siteConfig.contact.email}`} class="rounded-full border border-white/25 px-5 py-2.5 text-sm text-white/80 hover:bg-white/10">{music.epk.contactAction} ↗</a>
          </div>
        </div>
        <div class="space-y-6 border-l border-white/10 pl-6">
          <div><h3 class="mb-2 text-sm font-semibold text-white">{music.labels.equipment}</h3><p class="text-sm leading-relaxed text-white/60">{music.equipment}</p></div>
          <a href={music.tourSource} target="_blank" rel="noopener noreferrer" class="inline-block border-b border-white/35 pb-1 text-sm text-white/65 hover:text-white">{music.labels.source} ↗</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
