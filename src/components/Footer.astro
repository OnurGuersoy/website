---
import { siteConfig } from '../config/site.config';

const currentYear = new Date().getFullYear();
const { contact, name, location } = siteConfig;
---

<footer id="contact" class="mt-24 scroll-mt-20 border-t border-white/10">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="mb-9 max-w-xl">
      <h2 class="mb-4 text-3xl font-semibold tracking-tight md:text-4xl">{contact.title}</h2>
      <p class="leading-relaxed text-[var(--text-secondary)]">{contact.description}</p>
    </div>
    <a href={`mailto:${contact.email}`} class="inline-flex items-center rounded-full border border-[var(--accent)]/50 px-5 py-2.5 text-sm font-medium text-[var(--accent)] hover:bg-white/5">{contact.action} ↗</a>
    <div class="mt-10 flex flex-wrap gap-6">
      {contact.socials.map((social) => <a href={social.url} target="_blank" rel="noopener noreferrer" class="text-sm text-white/55 hover:text-white">{social.label} ↗</a>)}
    </div>
  </div>
  <div class="border-t border-white/10 px-6 py-5 text-xs text-white/40">
    <div class="mx-auto flex max-w-6xl flex-wrap justify-between gap-3"><span>© {currentYear} {name}</span><span>{location}</span></div>
  </div>
</footer>
