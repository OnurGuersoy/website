---
const base = '/website';
const currentYear = new Date().getFullYear();
---

<footer class="relative mt-24 border-t border-white/10">
  <!-- Contact Section -->
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Let's Work Together</h2>
      <p class="text-[var(--text-secondary)] max-w-xl mx-auto">
        Whether you need a drummer for your next tour, a session player for your record, 
        or an AI engineer for your next project — let's talk.
      </p>
    </div>
    
    <div class="flex flex-col md:flex-row items-center justify-center gap-6 mb-12">
      <a 
        href="mailto:contact@onurguersoy.de"
        class="group inline-flex items-center gap-3 px-8 py-4 rounded-full bg-[var(--accent)]/10 border border-[var(--accent)]/30 hover:bg-[var(--accent)]/20 hover:border-[var(--accent)]/50 transition-all duration-300 text-[var(--accent)] font-semibold"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        Get In Touch
      </a>
    </div>
    
    <!-- Social Links -->
    <div class="flex items-center justify-center gap-6">
      <a 
        href="https://www.instagram.com/onur_guersoy/" 
        target="_blank" 
        rel="noopener noreferrer"
        class="group p-3 rounded-full bg-white/5 hover:bg-white/10 border border-white/10 hover:border-[var(--accent)]/30 transition-all duration-300"
        aria-label="Instagram"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--text-secondary)] group-hover:text-[var(--accent)] transition-colors"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
      </a>
      
      <a 
        href="https://www.linkedin.com/in/onur-g%C3%BCrsoy-it/" 
        target="_blank" 
        rel="noopener noreferrer"
        class="group p-3 rounded-full bg-white/5 hover:bg-white/10 border border-white/10 hover:border-[var(--accent)]/30 transition-all duration-300"
        aria-label="LinkedIn"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--text-secondary)] group-hover:text-[var(--accent)] transition-colors"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
      </a>
      
      <a 
        href="https://github.com/OnurGuersoy" 
        target="_blank" 
        rel="noopener noreferrer"
        class="group p-3 rounded-full bg-white/5 hover:bg-white/10 border border-white/10 hover:border-[var(--accent)]/30 transition-all duration-300"
        aria-label="GitHub"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--text-secondary)] group-hover:text-[var(--accent)] transition-colors"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
      </a>
    </div>
  </div>
  
  <!-- Bottom Bar -->
  <div class="border-t border-white/5 py-6 px-6">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-[var(--text-secondary)]">
      <p>&copy; {currentYear} Onur Gürsoy. All rights reserved.</p>
      <p class="text-xs opacity-60">Drummer · AI Engineer · Hamburg, Germany</p>
    </div>
  </div>
</footer>
